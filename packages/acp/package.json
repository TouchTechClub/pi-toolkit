{
  "name": "@touchtechclub/pi-acp",
  "version": "0.2.0",
  "description": "ACP adapter for pi coding agent; maintained clone of svkozak/pi-acp",
  "license": "MIT",
  "author": "Sparsh Kaushik <github@sparshkaushik.com>",
  "contributors": [
    "Sergii Kozak <svkozak@gmail.com> (original creator, https://github.com/svkozak)",
    "Sparsh Kaushik <github@sparshkaushik.com> (maintainer, https://github.com/SparshKaushik)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TouchTechClub/pi-toolkit.git",
    "directory": "packages/acp"
  },
  "originalRepository": "https://github.com/svkozak/pi-acp",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/TouchTechClub/pi-toolkit/issues"
  },
  "homepage": "https://github.com/TouchTechClub/pi-toolkit/tree/main/packages/acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.13",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "prepack": "bun run build",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
