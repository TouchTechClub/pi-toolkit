{
  "name": "pi-toolkit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/acp build",
    "typecheck": "bun run --cwd packages/acp typecheck",
    "test": "bun run --cwd packages/acp test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "ruler:apply": "ruler apply --nested",
    "ruler:revert": "ruler revert"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@intellectronica/ruler": "^0.3.41"
  }
}
